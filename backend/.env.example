PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
JWT_SECRET=

# 첫 관리자 계정. users 테이블이 비어 있을 때 서버 시작 시 한 번만 만든다.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI 수정 (gemini 또는 claude)
AI_PROVIDER=gemini
AI_API_KEY=

# 실제 서버 배포용 FTP (npm run deploy 에서 사용)
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_REMOTE_DIR=/

# 실제 서버(닷홈) DB 값. 비워 두면 위의 DB_ 값을 그대로 쓴다.
# 닷홈은 보통 DB_HOST=localhost, DB 이름과 아이디가 FTP 아이디와 같다. FTP_REMOTE_DIR=/html
PROD_DB_HOST=
PROD_DB_NAME=
PROD_DB_USER=
PROD_DB_PASSWORD=
PROD_JWT_SECRET=
PROD_ADMIN_EMAIL=
PROD_ADMIN_PASSWORD=
